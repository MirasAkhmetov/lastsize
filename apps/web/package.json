{
  "name": "@lastsize/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; exec next dev --port 3000'",
    "build": "next build",
