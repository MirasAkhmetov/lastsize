# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env on the server and
# fill in. Never commit the filled-in file; keep a copy of it in a password manager.
# Secrets: openssl rand -hex 32 (hex keeps the values safe inside connection URLs).

# Domain on Cloudflare. www.<SITE_DOMAIN> redirects to it. The site and the admin panel are
# https://<SITE_DOMAIN> and https://<ADMIN_DOMAIN> (Cloudflare provides the certificates).
SITE_DOMAIN=lastsize.kz
ADMIN_DOMAIN=admin.lastsize.kz

# Cloudflare Tunnel: Zero Trust → Networks → Tunnels → Create (cloudflared) → copy the token.
# "tunnel" starts cloudflared in this stack. If a cloudflared on the host already serves this
# server, set COMPOSE_PROFILES= (empty) and point its hostnames at http://localhost:8080.
COMPOSE_PROFILES=tunnel
CLOUDFLARE_TUNNEL_TOKEN=

LOG_LEVEL=info

POSTGRES_USER=lastsize
POSTGRES_PASSWORD=
POSTGRES_DB=lastsize

REDIS_PASSWORD=

# openssl rand -base64 32. Never change it after launch without a re-encryption migration:
# encrypted TOTP seeds and marketplace tokens would become unreadable. Back it up separately.
SECRETS_ENCRYPTION_KEY=

S3_ACCESS_KEY=
S3_SECRET_KEY=

# Telegram bot for sellers (order alerts, password reset without SMS). Create it with @BotFather.
# Leave empty to switch it off. The token is a secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Browser push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Backups (deploy/backup.sh): where daily copies are kept on this server, how many days, and an
# optional off-site rclone remote (e.g. "b2:lastsize-backups"), see DEPLOY.md.
BACKUP_DIR=/var/backups/lastsize
BACKUP_KEEP_DAYS=14
BACKUP_REMOTE=
