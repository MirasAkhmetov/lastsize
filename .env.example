# Скопируйте в .env и задайте свои значения: cp .env.example .env
# .env никогда не коммитится. Здесь только локальные значения для разработки.

LOG_LEVEL=info

# --- Postgres (docker-compose) ---
POSTGRES_USER=lastsize
POSTGRES_PASSWORD=dev-only-change-me
POSTGRES_DB=lastsize
# Порт на вашем компьютере (5433, чтобы не конфликтовать с локальным Postgres)
POSTGRES_PORT=5433
DATABASE_URL=postgres://lastsize:dev-only-change-me@localhost:5433/lastsize

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (MinIO, S3-совместимое) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=kz-almaty-1
S3_ACCESS_KEY=lastsize-dev
S3_SECRET_KEY=dev-only-change-me-minio
S3_BUCKET_PUBLIC=lastsize-public
S3_BUCKET_PRIVATE=lastsize-private
# Where the dev proxy reads processed photos (/media/*). In production Caddy serves /media.
MEDIA_ORIGIN_URL=http://localhost:8888/buckets/lastsize-public

# --- API ---
API_HOST=0.0.0.0
API_PORT=4000
# Ключ шифрования секретов в БД (TOTP, токены WB/Kaspi): openssl rand -base64 32
# Это значение только для локальной разработки. На сервере сгенерируйте свой.
SECRETS_ENCRYPTION_KEY=/cDM8ho098Erp+LGyco/Gr/mw5/w4Kd0Lde/MaR0tS8=
# Origins, которым разрешены запросы к API из браузера (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Web ---
# Адрес API для серверных запросов Next.js (не попадает в браузер)
API_INTERNAL_URL=http://localhost:4000
# Публичный адрес сайта (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser push in development (localhost counts as a secure origin). Dev-only keys.
VAPID_PUBLIC_KEY=BD7DyJg9-qu8CLsykwOnaLT9XqypSb0MJ0pqoCqZ6zQPEefQwNVAzv8G8tYiX64B7Plw76-x7K7YsSvANjCPF7g
VAPID_PRIVATE_KEY=bqNJD3_6YVZcYC4Kgupkzbdz33SlzbmDrjGLaJeMz2M
# Telegram bot (optional): token and username from @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
